# Projeto DE0-CV (5CEBA4F23C7) — esqueleto gerado por fpga-new.
# A lista de fontes fica entre os marcadores e e regenerada por 'make sync'.
# Pinos, timing e demais assignments sao seus: nada aqui os reescreve.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY exp3_sensor
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SDC_FILE ../../constraints/de0_cv.sdc

# >>> fpga-sync: fontes de sintese (gerado a partir de rtl/ — nao edite) >>>
set_global_assignment -name VERILOG_FILE ../../rtl/contador_bcd_3digitos.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_cm_fd.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_cm_uc-PARCIAL.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_cm.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_m.v
set_global_assignment -name VERILOG_FILE ../../rtl/edge_detector.v
set_global_assignment -name VERILOG_FILE ../../rtl/exp3_sensor.v
set_global_assignment -name VERILOG_FILE ../../rtl/gerador_pulso.v
set_global_assignment -name VERILOG_FILE ../../rtl/hexa7seg.v
set_global_assignment -name VERILOG_FILE ../../rtl/interface_hcsr04_fd-PARCIAL.v
set_global_assignment -name VERILOG_FILE ../../rtl/interface_hcsr04_uc-PARCIAL.v
set_global_assignment -name VERILOG_FILE ../../rtl/interface_hcsr04.v
set_global_assignment -name VERILOG_FILE ../../rtl/registrador_n.v
# <<< fpga-sync <<<

# Pinagem do top (exp3_sensor) — Tabela 1 da apostila
# (interface-sensor-distancia-2026-v1.0.pdf, item k).

# clock -> CLK_50
set_location_assignment PIN_M9   -to clock
# reset -> SW0 / medir -> SW1
set_location_assignment PIN_U13  -to reset
set_location_assignment PIN_V13  -to medir

# echo -> GPIO_1_D3 / trigger -> GPIO_1_D1 (HC-SR04)
set_location_assignment PIN_B12  -to echo
set_location_assignment PIN_A12  -to trigger

# hex0 (unidade) -> HEX0
set_location_assignment PIN_U21  -to hex0[0]
set_location_assignment PIN_V21  -to hex0[1]
set_location_assignment PIN_W22  -to hex0[2]
set_location_assignment PIN_W21  -to hex0[3]
set_location_assignment PIN_Y22  -to hex0[4]
set_location_assignment PIN_Y21  -to hex0[5]
set_location_assignment PIN_AA22 -to hex0[6]
# hex1 (dezena) -> HEX1
set_location_assignment PIN_AA20 -to hex1[0]
set_location_assignment PIN_AB20 -to hex1[1]
set_location_assignment PIN_AA19 -to hex1[2]
set_location_assignment PIN_AA18 -to hex1[3]
set_location_assignment PIN_AB18 -to hex1[4]
set_location_assignment PIN_AA17 -to hex1[5]
set_location_assignment PIN_U22  -to hex1[6]
# hex2 (centena) -> HEX2
set_location_assignment PIN_Y19  -to hex2[0]
set_location_assignment PIN_AB17 -to hex2[1]
set_location_assignment PIN_AA10 -to hex2[2]
set_location_assignment PIN_Y14  -to hex2[3]
set_location_assignment PIN_V14  -to hex2[4]
set_location_assignment PIN_AB22 -to hex2[5]
set_location_assignment PIN_AB21 -to hex2[6]

# pronto -> LEDR[0] / db_medir -> LEDR[1]
set_location_assignment PIN_AA2  -to pronto
set_location_assignment PIN_AA1  -to db_medir

# db_trigger -> GPIO_1_D33 (CH1+ do Scope) / db_echo -> GPIO_1_D35 (CH2+ do Scope)
set_location_assignment PIN_G12  -to db_trigger
set_location_assignment PIN_K16  -to db_echo

# db_estado -> HEX5
set_location_assignment PIN_N9   -to db_estado[0]
set_location_assignment PIN_M8   -to db_estado[1]
set_location_assignment PIN_T14  -to db_estado[2]
set_location_assignment PIN_P14  -to db_estado[3]
set_location_assignment PIN_C1   -to db_estado[4]
set_location_assignment PIN_C2   -to db_estado[5]
set_location_assignment PIN_W19  -to db_estado[6]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clock
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to medir
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to echo
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to trigger
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pronto
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_medir
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_trigger
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_echo
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_estado[*]


set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top