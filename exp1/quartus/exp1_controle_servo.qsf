# ==========================================================================
# PCS3645 - Experiencia 1 - Atividade 2
# Circuito de controle de um servomotor (controle_servo)
# Placa DE0-CV  /  Cyclone V 5CEBA4F23C7N
# ==========================================================================

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY controle_servo
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# --- arquivos de projeto (sintese) ---------------------------------------
set_global_assignment -name VERILOG_FILE ../src/circuito_pwm.v
set_global_assignment -name VERILOG_FILE ../src/controle_servo.v
set_global_assignment -name SDC_FILE exp1_controle_servo.sdc

# --- simulacao ------------------------------------------------------------
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH controle_servo_tb -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME controle_servo_tb -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME controle_servo_tb -section_id controle_servo_tb
set_global_assignment -name EDA_TEST_BENCH_FILE ../sim/controle_servo_tb.v -section_id controle_servo_tb

# --- pinagem (Tabela 3 do roteiro) ---------------------------------------
# clock  -> CLK_50
set_location_assignment PIN_M9  -to clock
# reset  -> chave SW0
set_location_assignment PIN_U13 -to reset
# posicao[0] -> chave SW1 / posicao[1] -> chave SW2
set_location_assignment PIN_V13 -to posicao[0]
set_location_assignment PIN_T13 -to posicao[1]
# controle -> GPIO_0_D1 / db_controle -> GPIO_0_D3 (canal 1 do Scope)
set_location_assignment PIN_B16 -to controle
set_location_assignment PIN_C16 -to db_controle

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clock
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to posicao[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to posicao[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to controle
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_controle

# --- diversos -------------------------------------------------------------
# ALL = usa todos os nucleos que o Quartus detectar na maquina. Nao fixar um
# numero: 12 (threads do i7-1365U) gera Warning 20031, porque o Quartus conta
# nucleos fisicos (10), nao threads.
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
