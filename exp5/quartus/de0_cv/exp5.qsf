# Projeto DE0-CV (5CEBA4F23C7) — esqueleto gerado por fpga-new.
# A lista de fontes fica entre os marcadores e e regenerada por 'make sync'.
# Pinos, timing e demais assignments sao seus: nada aqui os reescreve.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C7
set_global_assignment -name TOP_LEVEL_ENTITY sonar
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SDC_FILE ../../constraints/de0_cv.sdc

# >>> fpga-sync: fontes de sintese (gerado a partir de rtl/ — nao edite) >>>
set_global_assignment -name VERILOG_FILE ../../rtl/circuito_pwm.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_bcd_3digitos.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_cm_fd.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_cm_uc.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_cm.v
set_global_assignment -name VERILOG_FILE ../../rtl/contador_m.v
set_global_assignment -name VERILOG_FILE ../../rtl/controle_servo_8.v
set_global_assignment -name VERILOG_FILE ../../rtl/deslocador_n.v
set_global_assignment -name VERILOG_FILE ../../rtl/gerador_pulso.v
set_global_assignment -name VERILOG_FILE ../../rtl/hexa7seg.v
set_global_assignment -name VERILOG_FILE ../../rtl/interface_hcsr04_fd.v
set_global_assignment -name VERILOG_FILE ../../rtl/interface_hcsr04_uc.v
set_global_assignment -name VERILOG_FILE ../../rtl/interface_hcsr04.v
set_global_assignment -name VERILOG_FILE ../../rtl/mux_8x1_n.v
set_global_assignment -name VERILOG_FILE ../../rtl/registrador_n.v
set_global_assignment -name VERILOG_FILE ../../rtl/rom_angulos_8x24.v
set_global_assignment -name VERILOG_FILE ../../rtl/sonar_fd.v
set_global_assignment -name VERILOG_FILE ../../rtl/sonar_uc.v
set_global_assignment -name VERILOG_FILE ../../rtl/sonar.v
set_global_assignment -name VERILOG_FILE ../../rtl/tx_serial_7E1_fd.v
set_global_assignment -name VERILOG_FILE ../../rtl/tx_serial_7E1.v
set_global_assignment -name VERILOG_FILE ../../rtl/tx_serial_uc.v
# <<< fpga-sync <<<

# Pinagem do top (sonar) — complete os PIN_?? pelo Pin Planner
# (make gui) ou pelo manual da DE0-CV, e descomente a linha.
# clock=CLOCK_50, reset=SW0, ligar=SW1
# trigger=GPIO_1_D1, echo=GPIO_1_D3, pwm=GPIO_0_D35, saida_serial=GPIO_0_D1, fim_posicao=GPIO_1_D35
# HEX0..2=medida, HEX3=posicao, HEX4=estado HC-SR04, HEX5=estado sonar; LEDR0..4=ligar,echo,trigger,pwm,saida_serial
set_location_assignment PIN_M9 -to clock
set_location_assignment PIN_U13 -to reset
set_location_assignment PIN_V13 -to ligar
set_location_assignment PIN_A12 -to trigger
set_location_assignment PIN_B12 -to echo
set_location_assignment PIN_T15 -to pwm
set_location_assignment PIN_B16 -to saida_serial
set_location_assignment PIN_K16 -to fim_posicao
set_location_assignment PIN_AA2 -to db_ligar
set_location_assignment PIN_AA1 -to db_echo
set_location_assignment PIN_W2 -to db_trigger
set_location_assignment PIN_Y3 -to db_pwm
set_location_assignment PIN_N2 -to db_saida_serial
set_location_assignment PIN_U21 -to db_medida0[0]
set_location_assignment PIN_V21 -to db_medida0[1]
set_location_assignment PIN_W22 -to db_medida0[2]
set_location_assignment PIN_W21 -to db_medida0[3]
set_location_assignment PIN_Y22 -to db_medida0[4]
set_location_assignment PIN_Y21 -to db_medida0[5]
set_location_assignment PIN_AA22 -to db_medida0[6]
set_location_assignment PIN_AA20 -to db_medida1[0]
set_location_assignment PIN_AB20 -to db_medida1[1]
set_location_assignment PIN_AA19 -to db_medida1[2]
set_location_assignment PIN_AA18 -to db_medida1[3]
set_location_assignment PIN_AB18 -to db_medida1[4]
set_location_assignment PIN_AA17 -to db_medida1[5]
set_location_assignment PIN_U22 -to db_medida1[6]
set_location_assignment PIN_Y19 -to db_medida2[0]
set_location_assignment PIN_AB17 -to db_medida2[1]
set_location_assignment PIN_AA10 -to db_medida2[2]
set_location_assignment PIN_Y14 -to db_medida2[3]
set_location_assignment PIN_V14 -to db_medida2[4]
set_location_assignment PIN_AB22 -to db_medida2[5]
set_location_assignment PIN_AB21 -to db_medida2[6]
set_location_assignment PIN_Y16 -to db_posicao[0]
set_location_assignment PIN_W16 -to db_posicao[1]
set_location_assignment PIN_Y17 -to db_posicao[2]
set_location_assignment PIN_V16 -to db_posicao[3]
set_location_assignment PIN_U17 -to db_posicao[4]
set_location_assignment PIN_V18 -to db_posicao[5]
set_location_assignment PIN_V19 -to db_posicao[6]
set_location_assignment PIN_U20 -to db_estado_sensor[0]
set_location_assignment PIN_Y20 -to db_estado_sensor[1]
set_location_assignment PIN_V20 -to db_estado_sensor[2]
set_location_assignment PIN_U16 -to db_estado_sensor[3]
set_location_assignment PIN_U15 -to db_estado_sensor[4]
set_location_assignment PIN_Y15 -to db_estado_sensor[5]
set_location_assignment PIN_P9 -to db_estado_sensor[6]
set_location_assignment PIN_N9 -to db_estado[0]
set_location_assignment PIN_M8 -to db_estado[1]
set_location_assignment PIN_T14 -to db_estado[2]
set_location_assignment PIN_P14 -to db_estado[3]
set_location_assignment PIN_C1 -to db_estado[4]
set_location_assignment PIN_C2 -to db_estado[5]
set_location_assignment PIN_W19 -to db_estado[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clock
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ligar
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to trigger
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to echo
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pwm
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to saida_serial
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fim_posicao
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_ligar
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_echo
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_trigger
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to db_pwm
